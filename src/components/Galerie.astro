---
// Galerie en colonnes (photos en portrait et en paysage mélangées) avec visionneuse plein écran.
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import type { PhotoDossier } from '../lib/photos';

interface Props {
  photos: PhotoDossier[];
}

const { photos } = Astro.props;

// Version grand format pour la visionneuse
const grandes = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 2000), format: 'webp' })),
);
---

<div data-galerie>
  <ul class="columns-2 gap-4 md:columns-3">
    {photos.map((photo, i) => (
      <li class="reveal mb-4 break-inside-avoid">
        <button
          type="button"
          data-index={i}
          data-src={grandes[i].src}
          data-alt={photo.alt}
          class="group block w-full cursor-zoom-in overflow-hidden rounded-3xl"
          aria-label={`Agrandir : ${photo.alt}`}
        >
          <Photo
            image={photo.src}
            label={photo.alt}
            sizes="(min-width: 768px) 33vw, 50vw"
            class="h-auto w-full transition duration-500 group-hover:scale-105"
          />
        </button>
      </li>
    ))}
  </ul>

  <dialog
    class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink/95 p-0 text-white backdrop:bg-transparent open:flex open:items-center open:justify-center"
    aria-label="Visionneuse de photos"
  >
    <figure class="flex max-h-full max-w-full flex-col items-center gap-4 px-4 py-16 sm:px-20">
      <img data-grande alt="" class="max-h-[78dvh] w-auto max-w-full rounded-2xl object-contain" />
      <figcaption data-legende class="text-center text-sm text-white/80"></figcaption>
    </figure>

    <button type="button" data-fermer class="absolute top-4 right-4 grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Fermer">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16" /></svg>
    </button>
    <button type="button" data-precedent class="absolute top-1/2 left-3 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Photo précédente">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m12 4-6 6 6 6" /></svg>
    </button>
    <button type="button" data-suivant class="absolute top-1/2 right-3 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Photo suivante">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 4 6 6-6 6" /></svg>
    </button>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-galerie]').forEach((galerie) => {
    const vignettes = [...galerie.querySelectorAll<HTMLButtonElement>('button[data-index]')];
    const dialog = galerie.querySelector('dialog')!;
    const grande = dialog.querySelector<HTMLImageElement>('[data-grande]')!;
    const legende = dialog.querySelector<HTMLElement>('[data-legende]')!;
    let courante = 0;

    const afficher = (index: number) => {
      courante = (index + vignettes.length) % vignettes.length;
      const { src, alt } = vignettes[courante].dataset;
      // Vide l'image d'abord pour ne pas montrer la précédente pendant le chargement
      grande.removeAttribute('src');
      grande.src = src!;
      grande.alt = alt!;
      legende.textContent = `${alt} · ${courante + 1} / ${vignettes.length}`;
    };

    vignettes.forEach((vignette, i) =>
      vignette.addEventListener('click', () => {
        afficher(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-fermer]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-precedent]')!.addEventListener('click', () => afficher(courante - 1));
    dialog.querySelector('[data-suivant]')!.addEventListener('click', () => afficher(courante + 1));
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') afficher(courante - 1);
      if (e.key === 'ArrowRight') afficher(courante + 1);
    });
    // Rend le focus à la vignette d'origine quand on ferme
    dialog.addEventListener('close', () => vignettes[courante].focus());
  });
</script>
