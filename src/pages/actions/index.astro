---
// Vue d'ensemble des 5 thématiques, chacune renvoie vers sa page.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import { links } from '../../config/site';
import { photosDu } from '../../lib/photos';

const thematiques = (await getCollection('thematiques'))
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .map((t) => ({ ...t, bandeau: photosDu(t.id).bandeau }));
---

<BaseLayout
  title="Nos actions"
  description="Mobilité internationale, environnement, patrimoine, insertion professionnelle et tiers-lieu : les cinq pôles d'action de LEPAM Mayotte."
>
  <!-- Introduction -->
  <section class="bg-brand-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <p class="text-sm font-medium tracking-wide text-accent uppercase">Nos actions</p>
      <h1 class="mt-4 max-w-3xl text-5xl font-semibold tracking-tight text-balance sm:text-6xl">
        Cinq pôles pour agir avec la <span class="text-gradient">jeunesse de Mayotte</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft">
        Partir à l'étranger, protéger son île, découvrir son histoire, trouver sa voie, se former : chaque pôle répond à un besoin concret des habitants de Petite-Terre.
      </p>

      <!-- Accès direct à chaque pôle -->
      <nav aria-label="Aller à un pôle" class="mt-10">
        <ul class="flex flex-wrap gap-2">
          {thematiques.map((t) => (
            <li>
              <a href={`#${t.id}`} class="block rounded-full bg-white px-4 py-2 text-sm font-medium ring-1 ring-black/10 transition hover:ring-accent">
                {t.data.titre}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Les 5 pôles -->
  <div class="mx-auto max-w-6xl space-y-20 px-4 py-20 sm:space-y-28 sm:px-6 md:py-28">
    {thematiques.map((t, i) => (
      <section id={t.id} aria-labelledby={`titre-${t.id}`} class="reveal grid scroll-mt-24 items-center gap-8 md:grid-cols-2 md:gap-16">
        <a href={`/actions/${t.id}`} tabindex="-1" aria-hidden="true" class:list={['group block overflow-hidden rounded-3xl', i % 2 === 1 && 'md:order-2']}>
          <Photo
            image={t.bandeau}
            label={t.data.photo}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-[4/3] w-full transition duration-500 group-hover:scale-105"
          />
        </a>
        <div>
          <p class="text-sm font-medium text-accent">{String(i + 1).padStart(2, '0')} · {t.data.titre}</p>
          <h2 id={`titre-${t.id}`} class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{t.data.accroche}</h2>
          <p class="mt-4 text-lg text-ink-soft">{t.data.resume}</p>

          {t.data.chiffres.length > 0 && (
            <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
              {t.data.chiffres.slice(0, 2).map((c) => (
                <div class="flex flex-col-reverse justify-end">
                  <dt class="text-sm text-ink-soft">{c.label}</dt>
                  <dd class="text-gradient text-3xl font-semibold tracking-tight">{c.valeur}</dd>
                </div>
              ))}
            </dl>
          )}

          <a href={`/actions/${t.id}`} class="mt-7 inline-flex items-center gap-1 rounded-full bg-ink px-5 py-2.5 font-medium text-white transition hover:bg-ink/85">
            Découvrir le pôle <span class="sr-only">{t.data.titre}</span> <span aria-hidden="true">›</span>
          </a>
        </div>
      </section>
    ))}
  </div>

  <!-- Engagement -->
  <section class="px-4 pb-24 sm:px-6">
    <div class="bg-gradient-brand mx-auto max-w-6xl rounded-[2rem] px-6 py-16 text-center text-white sm:py-20">
      <h2 class="mx-auto max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Envie d'agir avec nous ?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/85">
        Bénévole, adhérent ou donateur : chacun peut faire grandir nos projets.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/s-engager" class="rounded-full bg-white px-6 py-3 font-medium text-accent transition hover:bg-white/90">S'engager</a>
        <a href={links.adhesion} class="rounded-full bg-white/15 px-6 py-3 font-medium text-white ring-1 ring-white/50 transition hover:bg-white/25">Adhérer</a>
        <a href={links.don} class="rounded-full bg-white/15 px-6 py-3 font-medium text-white ring-1 ring-white/50 transition hover:bg-white/25">Faire un don</a>
      </div>
    </div>
  </section>
</BaseLayout>
