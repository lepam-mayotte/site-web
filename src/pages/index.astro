---
// Page d'accueil : accroche en deux colonnes, thématiques en grille, chiffres, actualités, engagement.
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import ListeActus from '../components/ListeActus.astro';
import Partenaires from '../components/Partenaires.astro';
import Financeurs from '../components/Financeurs.astro';
import BandeauReseaux from '../components/BandeauReseaux.astro';
import { getCollection } from 'astro:content';
import { links } from '../config/site';
import { chiffres } from '../config/association';
import { photosDu } from '../lib/photos';

const thematiques = (await getCollection('thematiques')).sort((a, b) => a.data.ordre - b.data.ordre);

// Mosaïque de l'accroche : les 3 premières photos de src/assets/photos/accueil/
const accueil = photosDu('accueil').galerie;
const mosaique = ['Mobilité à Nosy Be', 'Plage des Badamiers', 'Tiers-lieu'].map((legende, i) => ({
  image: accueil[i]?.src,
  label: accueil[i]?.alt ?? legende,
}));

const engagements = [
  { titre: 'Adhérer', texte: 'Devenez membre et participez à la vie de l’association.', href: links.adhesion },
  { titre: 'Faire un don', texte: 'Financez directement nos actions auprès des jeunes de Mayotte.', href: links.don },
  { titre: 'Devenir bénévole', texte: 'Donnez un peu de votre temps lors de nos événements.', href: '/s-engager#benevolat' },
];
---

<BaseLayout>
  <!-- Accroche -->
  <section class="bg-brand-50">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <p class="text-sm font-medium tracking-wide text-accent uppercase">LEPAM Mayotte</p>
        <h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-6xl">
          Luttons ensemble pour un <span class="text-gradient">avenir meilleur</span>.
        </h1>
        <p class="mt-6 max-w-lg text-lg text-ink-soft">
          Depuis 2022, nous menons des projets d'éducation, de mobilité, d'environnement, de patrimoine et d'insertion à Mayotte, et nous animons un tiers-lieu de compétences ouvert à tous.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={links.don} class="bg-gradient-brand rounded-full px-6 py-3 font-medium text-white shadow-sm transition hover:opacity-90">Faire un don</a>
          <a href="/actions" class="rounded-full bg-white px-6 py-3 font-medium text-ink ring-1 ring-black/10 transition hover:ring-black/20">Nos actions</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <Photo {...mosaique[0]} loading="eager" sizes="(min-width: 768px) 25vw, 50vw" class="row-span-2 aspect-[3/4] h-full rounded-3xl" />
        <Photo {...mosaique[1]} loading="eager" sizes="(min-width: 768px) 25vw, 50vw" class="aspect-square rounded-3xl" />
        <Photo {...mosaique[2]} loading="eager" sizes="(min-width: 768px) 25vw, 50vw" class="aspect-square rounded-3xl" />
      </div>
    </div>
  </section>

  <BandeauReseaux />

  <!-- Thématiques en grille -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">Nos actions</h2>
      <a href="/actions" class="shrink-0 font-medium text-accent hover:underline">Tout voir ›</a>
    </div>
    <p class="mt-3 max-w-xl text-lg text-ink-soft">Cinq pôles, une même ambition : donner à chacun les moyens de construire son avenir.</p>

    <ul class="mt-12 grid gap-4 md:grid-cols-3 md:grid-rows-2">
      {thematiques.map((t, i) => (
        <li class:list={['reveal', i === 0 && 'md:row-span-2']}>
          <a href={`/actions/${t.id}`} class="group relative flex h-full min-h-64 overflow-hidden rounded-3xl">
            <div class="absolute inset-0 transition duration-500 group-hover:scale-105">
              <Photo image={photosDu(t.id).bandeau} label={t.data.photo} sizes="(min-width: 768px) 33vw, 100vw" class="size-full" />
            </div>
            <div class="relative mt-auto w-full bg-gradient-to-t from-ink/80 via-ink/40 to-transparent p-6 pt-20 text-white">
              <h3 class="text-2xl font-semibold tracking-tight">{t.data.titre}</h3>
              <p class="mt-1 text-white/85">{t.data.accroche}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Chiffres clés -->
  <section class="bg-gradient-brand text-white">
    <div class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Nos chiffres clés 2025</h2>
    </div>
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-10 px-4 pt-10 pb-16 sm:px-6 md:grid-cols-4">
      {chiffres.slice(0, 4).map((c) => (
        <div>
          <p class="text-5xl font-semibold tracking-tight">{c.valeur}</p>
          <p class="mt-2 text-white/85">{c.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Actualités -->
  <section class="bg-mist">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">Actualités</h2>
        <a href="/actualites" class="shrink-0 font-medium text-accent hover:underline">Tout voir ›</a>
      </div>
      <div class="mt-10">
        <ListeActus />
      </div>
    </div>
  </section>

  <!-- Engagement -->
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 class="text-center text-4xl font-semibold tracking-tight sm:text-5xl">Agir avec nous</h2>
    <ul class="mt-12 grid gap-4 md:grid-cols-3">
      {engagements.map((e) => (
        <li class="reveal">
          <a href={e.href} class="block h-full rounded-3xl p-8 ring-1 ring-black/10 transition hover:ring-brand-orange">
            <h3 class="text-gradient text-2xl font-semibold tracking-tight">{e.titre}</h3>
            <p class="mt-3 text-ink-soft">{e.texte}</p>
            <p class="mt-6 font-medium text-accent">Continuer ›</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Partenaires />
  <Financeurs />
</BaseLayout>
