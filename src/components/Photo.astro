---
// Affiche une photo optimisée, ou un emplacement provisoire si la photo n'est pas encore fournie.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  label: string; // texte alternatif de la photo, ou légende de l'emplacement provisoire
  image?: ImageMetadata;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { label, image, sizes = '100vw', loading = 'lazy', class: className = '' } = Astro.props;
---

{image ? (
  <Image
    src={image}
    alt={label}
    widths={[480, 960, 1600, 2400].filter((w) => w <= image.width)}
    sizes={sizes}
    loading={loading}
    class:list={['object-cover', className]}
  />
) : (
  <div
    role="img"
    aria-label={`Photo à venir : ${label}`}
    class:list={[
      'relative flex items-start overflow-hidden bg-gradient-to-br from-brand-100 via-mist to-[#ffe1e8]',
      className,
    ]}
  >
    <svg class="absolute inset-0 m-auto size-12 text-brand-coral/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <circle cx="9" cy="10" r="1.6" />
      <path d="m21 16-5-5-8 8" />
    </svg>
    <span class="relative m-4 rounded-full bg-white/80 px-3 py-1 text-xs text-ink-soft backdrop-blur">{label}</span>
  </div>
)}
