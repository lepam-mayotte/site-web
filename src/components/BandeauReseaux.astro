---
// Bandeau de l'accueil : les reconnaissances de l'association, avec un lien vers le détail.
import LogoReseau from './LogoReseau.astro';
import { reseaux } from '../config/association';
---

<section aria-label="Nos réseaux" class="border-b border-black/5">
  <ul class="mx-auto grid max-w-6xl gap-px px-4 sm:px-6 md:grid-cols-2">
    {reseaux.map((r) => (
      <li>
        <a href={`/association#${r.id}`} class="group flex flex-wrap items-center gap-x-4 gap-y-2 py-6 md:px-4">
          <LogoReseau logo={r.logo} nom={r.nom} class="h-10" />
          <span class="min-w-48 flex-1 text-lg font-semibold tracking-tight text-balance group-hover:text-accent">{r.court}</span>
          <span aria-hidden="true" class="text-accent">›</span>
        </a>
      </li>
    ))}
  </ul>
</section>
