---
// Liste des dernières actualités, toutes thématiques confondues ou filtrées sur une seule.
import { getCollection } from 'astro:content';
import CarteActu from './CarteActu.astro';

interface Props {
  thematique?: string;
  limite?: number;
  exclure?: string; // identifiant d'une actualité à ne pas afficher (celle qu'on est en train de lire)
}

const { thematique, limite = 3, exclure } = Astro.props;

const actus = (
  await getCollection('actus', (a) => (!thematique || a.data.thematique.id === thematique) && a.id !== exclure)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limite);

const thematiques = await getCollection('thematiques');
const nomThematique = (id: string) => thematiques.find((t) => t.id === id)?.data.titre;
---

{actus.length > 0 && (
  <ul class="grid gap-6 md:grid-cols-3">
    {actus.map((actu) => (
      <li class="reveal">
        <CarteActu actu={actu} nomThematique={nomThematique(actu.data.thematique.id)} />
      </li>
    ))}
  </ul>
)}
