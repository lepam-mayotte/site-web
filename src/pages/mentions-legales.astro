---
// Mentions légales et politique de confidentialité.
// Les informations de l'association se règlent dans src/config/site.ts (objet « legal »).
import BaseLayout from '../layouts/BaseLayout.astro';
import { legal, site } from '../config/site';

const sections = [
  { id: 'editeur', titre: 'Éditeur du site' },
  { id: 'hebergement', titre: 'Hébergement' },
  { id: 'propriete', titre: 'Propriété intellectuelle' },
  { id: 'donnees', titre: 'Données personnelles' },
  { id: 'cookies', titre: 'Cookies' },
  { id: 'liens', titre: 'Liens externes' },
];
---

<BaseLayout title="Mentions légales" description="Mentions légales, données personnelles et cookies du site de LEPAM Mayotte.">
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
    <p class="text-sm font-medium tracking-wide text-accent uppercase">Informations légales</p>
    <h1 class="mt-4 text-5xl font-semibold tracking-tight sm:text-6xl">Mentions légales</h1>
    <p class="mt-4 text-ink-soft">Dernière mise à jour : {legal.miseAJour}</p>

    <nav aria-label="Sommaire" class="mt-10 rounded-3xl bg-mist p-6">
      <ol class="grid gap-2 sm:grid-cols-2">
        {sections.map((s, i) => (
          <li><a href={`#${s.id}`} class="text-ink/80 hover:text-accent">{i + 1}. {s.titre}</a></li>
        ))}
      </ol>
    </nav>

    <div class="texte mt-12 space-y-14 text-lg leading-relaxed text-ink/85">
      <section id="editeur">
        <h2>1. Éditeur du site</h2>
        <dl>
          <dt>Nom</dt>
          <dd>{site.fullName} ({site.name})</dd>
          <dt>Forme juridique</dt>
          <dd>{legal.forme}</dd>
          {legal.rna && (
            <>
              <dt>Numéro RNA</dt>
              <dd>{legal.rna}</dd>
            </>
          )}
          {legal.siret && (
            <>
              <dt>SIRET</dt>
              <dd>{legal.siret}</dd>
            </>
          )}
          <dt>Siège</dt>
          <dd>{legal.siege}</dd>
          <dt>Téléphone</dt>
          <dd><a href={site.telephoneLien}>{site.telephone}</a></dd>
          <dt>E-mail</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          <dt>Responsable de la publication</dt>
          <dd>{legal.responsablePublication}</dd>
        </dl>
      </section>

      <section id="hebergement">
        <h2>2. Hébergement</h2>
        <p>
          Le site est hébergé par <strong>Netlify, Inc.</strong>, 101 2nd Street, San Francisco, CA 94105, États-Unis
          (<a href="https://www.netlify.com">netlify.com</a>).
        </p>
        <p>
          Les adhésions, les dons et la billetterie sont gérés sur la plateforme <strong>AssoConnect</strong>
          (<a href="https://www.assoconnect.com">assoconnect.com</a>), selon ses propres conditions d'utilisation.
        </p>
      </section>

      <section id="propriete">
        <h2>3. Propriété intellectuelle</h2>
        <p>
          Les textes, photos, logos et éléments graphiques de ce site appartiennent à {site.name}, sauf mention contraire.
          Toute reproduction sans autorisation écrite de l'association est interdite.
        </p>
        <p>
          Les logos des partenaires et financeurs restent la propriété de leurs titulaires respectifs.
        </p>
        <p>
          Vous apparaissez sur une photo et souhaitez qu'elle soit retirée ? Écrivez-nous à
          <a href={`mailto:${site.email}`}>{site.email}</a> : nous la retirerons dans les meilleurs délais.
        </p>
      </section>

      <section id="donnees">
        <h2>4. Données personnelles</h2>
        <p>
          Ce site ne contient aucun formulaire et ne collecte directement aucune donnée personnelle.
          Le dépôt de CV se fait sur un formulaire externe, hébergé par Google : les informations transmises servent
          uniquement à étudier les candidatures.
        </p>
        <p>
          Lorsque vous nous écrivez par e-mail, vos coordonnées sont utilisées uniquement pour vous répondre et ne sont jamais
          cédées à des tiers.
        </p>
        <p>
          Les données saisies lors d'une adhésion, d'un don ou d'une inscription à un événement sont traitées par l'association
          via AssoConnect, pour la gestion de ses membres, de ses dons et de ses événements.
        </p>
        <p>
          Conformément au Règlement général sur la protection des données (RGPD) et à la loi Informatique et Libertés, vous
          disposez d'un droit d'accès, de rectification, d'effacement et d'opposition sur vos données. Pour l'exercer, écrivez à
          <a href={`mailto:${site.email}`}>{site.email}</a>. Vous pouvez également adresser une réclamation à la
          <a href="https://www.cnil.fr">CNIL</a>.
        </p>
      </section>

      <section id="cookies">
        <h2>5. Cookies</h2>
        <p>
          Ce site ne dépose aucun cookie, n'utilise aucun outil de mesure d'audience et aucune publicité. C'est pourquoi
          aucune bannière de consentement ne vous est demandée.
        </p>
        <p>
          La carte du tiers-lieu est fournie par <a href="https://www.openstreetmap.org">OpenStreetMap</a>, sans cookie.
          Les pages AssoConnect (adhésion, dons, billetterie) peuvent déposer leurs propres cookies techniques, nécessaires à
          leur fonctionnement.
        </p>
      </section>

      <section id="liens">
        <h2>6. Liens externes</h2>
        <p>
          Ce site contient des liens vers d'autres sites (AssoConnect, réseaux sociaux, partenaires). L'association n'est pas
          responsable de leur contenu.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  @reference "../styles/global.css";

  .texte :global(h2) {
    @apply mb-5 scroll-mt-24 text-3xl font-semibold tracking-tight text-ink;
  }
  .texte :global(p + p) {
    @apply mt-4;
  }
  .texte :global(a) {
    @apply font-medium text-accent underline underline-offset-2;
  }
  .texte :global(strong) {
    @apply font-semibold text-ink;
  }
  .texte dl {
    @apply grid gap-x-8 gap-y-3 sm:grid-cols-[auto_1fr];
  }
  .texte dt {
    @apply font-medium text-ink;
  }
</style>
