---
import { partenaires } from '../config/association';
---

<section class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6">
  <h2 class="text-sm font-medium tracking-wide text-ink-soft uppercase">Ils nous font confiance</h2>
  <ul class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-4 text-lg font-medium text-ink/60">
    {partenaires.map((p) => <li>{p}</li>)}
  </ul>
</section>
