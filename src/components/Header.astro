---
import { Image } from 'astro:assets';
import embleme from '../assets/logo-embleme.png';
import { nav } from '../config/site';

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-white/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="LEPAM Mayotte, accueil">
      <Image src={embleme} alt="" height={72} class="h-9 w-auto" />
      <span class="text-lg font-semibold tracking-tight">LEPAM</span>
    </a>

    <nav aria-label="Menu principal" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-sm text-ink/80">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:font-medium"
              aria-current={current.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/s-engager"
        class="bg-gradient-brand rounded-full px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
      >
        <span class="sm:hidden">Nous soutenir</span>
        <span class="hidden sm:inline">Adhérer / Faire un don</span>
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="grid size-10 place-items-center rounded-full hover:bg-mist lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 6h14M3 14h14" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Menu mobile" class="hidden border-t border-black/5 bg-white lg:hidden">
    <ul class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="block border-b border-black/5 py-4 text-2xl font-medium tracking-tight last:border-0">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('menu-mobile')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
    menu.classList.toggle('hidden', open);
  });
</script>
