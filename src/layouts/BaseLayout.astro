---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { legal, site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata; // photo de la page pour les aperçus de partage (sinon l'image par défaut)
  noindex?: boolean; // pages techniques à ne pas faire apparaître dans Google
}

const { title, description = site.description, image, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.fullName}`;

// Adresse officielle de la page, sans « .html » (voir build.format dans astro.config.mjs)
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonique = new URL(chemin, Astro.site);

// Image d'aperçu pour WhatsApp, Facebook, LinkedIn…
const apercu = image
  ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.site)
  : new URL('/og-image.jpg', Astro.site);

// Fiche d'identité de l'association pour les moteurs de recherche (page d'accueil seulement)
const ficheAssociation =
  chemin === '/'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'NGO',
        name: site.name,
        alternateName: site.fullName,
        url: Astro.site?.href,
        logo: new URL('/og-image.jpg', Astro.site).href,
        description: site.description,
        email: site.email,
        telephone: site.telephoneLien.replace('tel:', '').replace(/\s/g, ''),
        identifier: legal.rna,
        address: {
          '@type': 'PostalAddress',
          streetAddress: '53 boulevard des Amoureux',
          postalCode: '97615',
          addressLocality: 'Dzaoudzi-Labattoir',
          addressRegion: 'Mayotte',
          addressCountry: 'FR',
        },
        sameAs: site.socials.filter((r) => r.url).map((r) => r.url),
      })
    : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonique} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={apercu} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    {ficheAssociation && <script type="application/ld+json" set:html={ficheAssociation} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
