---
import { Image } from 'astro:assets';
import logoComplet from '../assets/logo-complet.png';
import { links, nav, site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="bg-mist text-sm text-ink-soft">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <Image src={logoComplet} alt={`${site.name}, ${site.fullName}`} width={224} class="size-28 rounded-full bg-white" />
      <p class="mt-4">{site.address}</p>
      <a href={site.telephoneLien} class="mt-1 block hover:text-ink">{site.telephone}</a>
      <a href={`mailto:${site.email}`} class="mt-1 block hover:text-ink">{site.email}</a>
    </div>

    <div>
      <p class="font-medium text-ink">Le site</p>
      <ul class="mt-3 space-y-2">
        {nav.map((item) => <li><a href={item.href} class="hover:text-ink">{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <p class="font-medium text-ink">Nous soutenir</p>
      <ul class="mt-3 space-y-2">
        <li><a href={links.adhesion} class="hover:text-ink">Adhérer</a></li>
        <li><a href={links.don} class="hover:text-ink">Faire un don</a></li>
        {site.socials.filter((r) => r.url).map((r) => <li><a href={r.url} class="hover:text-ink">{r.nom}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-black/5">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs sm:flex-row sm:justify-between sm:px-6">
      <p>© {year} {site.name}</p>
      <div class="flex gap-6">
        <a href="/mentions-legales" class="hover:text-ink">Mentions légales</a>
        <a href={links.connexion} class="inline-flex items-center gap-1.5 hover:text-ink">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="5" y="11" width="14" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
          Espace administrateur
        </a>
      </div>
    </div>
  </div>
</footer>
