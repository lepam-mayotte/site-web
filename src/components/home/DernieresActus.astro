---
import { getCollection } from 'astro:content';
import { thematiques } from '../../config/thematiques';

const actus = (await getCollection('actus'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const nomThematique = (slug: string) => thematiques.find((t) => t.slug === slug)?.titre;
const formatDate = (date: Date) =>
  date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<ul class="grid gap-6 md:grid-cols-3">
  {actus.map((actu) => (
    <li class="reveal">
      <a href={`/actualites/${actu.id}`} class="group block h-full rounded-3xl bg-white p-7 shadow-sm ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-md">
        <p class="text-xs font-medium tracking-wide text-brand-red uppercase">{nomThematique(actu.data.thematique)}</p>
        <h3 class="mt-3 text-xl font-semibold tracking-tight">{actu.data.titre}</h3>
        <p class="mt-3 text-ink-soft">{actu.data.resume}</p>
        <p class="mt-6 text-sm text-ink-soft">{formatDate(actu.data.date)}</p>
      </a>
    </li>
  ))}
</ul>
