---
// Logo d'un réseau, lu dans src/assets/logos/reseaux/. Rien n'est affiché tant que le fichier n'est pas déposé.
import { Image } from 'astro:assets';
import { logoDans } from '../lib/logos';

interface Props {
  logo: string;
  nom: string;
  class?: string;
}

const { logo, nom, class: className = '' } = Astro.props;
const image = logoDans('reseaux', logo);
---

{image && <Image src={image} alt={`Logo ${nom}`} height={image.height} class:list={['w-auto max-w-full object-contain object-left', className]} />}
