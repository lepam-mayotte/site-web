---
// Emplacement provisoire en attendant les vraies photos de l'association.
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<div
  role="img"
  aria-label={`Photo à venir : ${label}`}
  class:list={[
    'relative flex items-start overflow-hidden bg-gradient-to-br from-brand-100 via-mist to-[#ffe1dc]',
    className,
  ]}
>
  <svg class="absolute inset-0 m-auto size-12 text-brand-orange/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <circle cx="9" cy="10" r="1.6" />
    <path d="m21 16-5-5-8 8" />
  </svg>
  <span class="relative m-4 rounded-full bg-white/80 px-3 py-1 text-xs text-ink-soft backdrop-blur">{label}</span>
</div>
